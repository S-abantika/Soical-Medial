  "posts": [
    {
      "_id": "post_realtime_stack",
      "authorId": "usr_alexchen",
      "author": {
        "_id": "usr_alexchen",
        "username": "alexchen",
        "name": "Alex Chen",
        "avatar": "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&auto=format&fit=crop&q=80",
        "isVerified": true,
        "headline": "Staff Systems Architect & Tech Lead"
      },
      "content": "⚡ Exciting update: We just completed our full-stack real-time architecture utilizing Express, Socket.io, JWT tokens, and MongoDB document persistence!\n\nThe latency between state mutations and UI reconciliation across multiple connected clients is now under 12ms. Check out the clean real-time message stream below! 🚀\n\nWhat are your favorite patterns for handling socket reconnection in production?",
      "mediaUrl": "https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1200&auto=format&fit=crop&q=80",
      "mediaType": "image",
      "tags": [
        "FullStack",
        "NodeJS",
        "Express",
        "SocketIO",
        "WebDev",
        "React"
      ],
      "likes": [
        "usr_sarahdev",
        "usr_marcus_ai",
        "usr_elena_design",
        "usr_jordan_cloud"
      ],
      "reposts": [
        "usr_sarahdev",
        "usr_elena_design"
      ],
      "commentsCount": 3,
      "pinned": true,
      "createdAt": "2026-08-31T11:20:35.114Z",
      "updatedAt": "2026-08-31T11:20:35.114Z"
    },
    {
      "_id": "post_clean_ui",
      "authorId": "usr_elena_design",
      "author": {
        "_id": "usr_elena_design",
        "username": "elena_design",
        "name": "Elena Rostova",
        "avatar": "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&auto=format&fit=crop&q=80",
        "isVerified": true,
        "headline": "Design Director @ Atelier Labs"
      },
      "content": "Design tip of the week: Stop using arbitrary purple-to-blue gradients and floating glow cards. Instead:\n\n1. Use refined neutral palettes with <5% saturation\n2. Establish strict mathematical hierarchy (Major Second / Perfect Fourth)\n3. Calculate inner border-radius = outer radius - padding\n\nHigh visual craft comes from disciplined negative space and typography! ✨",
      "mediaUrl": "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?w=1200&auto=format&fit=crop&q=80",
      "mediaType": "image",
      "tags": [
        "UIUX",
        "DesignSystems",
        "Typography",
        "Frontend"
      ],
      "likes": [
        "usr_alexchen",
        "usr_sarahdev",
        "usr_marcus_ai"
      ],
      "reposts": [
        "usr_alexchen"
      ],
      "commentsCount": 2,
      "createdAt": "2026-08-31T07:20:35.114Z",
      "updatedAt": "2026-08-31T07:20:35.114Z"
    },
    {
      "_id": "post_backend_poll",
      "authorId": "usr_marcus_ai",
      "author": {
        "_id": "usr_marcus_ai",
